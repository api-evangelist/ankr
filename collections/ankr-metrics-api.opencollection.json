{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ankr Advanced EVM Metrics API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Metrics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Ankr Get Staking Metrics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://rpc.ankr.com/multichain/v1.0/metrics"
          },
          "docs": "Returns Ankr Liquid Staking metrics across all supported tokens."
        },
        {
          "info": {
            "name": "Ankr Get Staking Metrics By Token",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://rpc.ankr.com/multichain/v1.0/metrics/:token",
            "params": [
              {
                "name": "token",
                "value": "",
                "type": "path",
                "description": "Liquid staking token symbol."
              }
            ]
          },
          "docs": "Returns staking metrics for a single liquid staking token."
        }
      ]
    }
  ],
  "bundled": true
}